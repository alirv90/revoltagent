{
  "name": "voltagent-example-with-web-worker",
  "description": "Run a VoltAgent workflow with andAgent + Supabase memory inside a browser Web Worker.",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:lib": "tsc --noEmit && vite build --config vite.lib.config.ts && node -e \"require('node:fs').copyFileSync('voltagent.d.ts','dist/voltagent.d.ts')\"",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.0",
    "@opentelemetry/api": "^1.9.0",
    "@supabase/supabase-js": "^2.49.4",
    "@voltagent/core": "^2.7.3",
    "@voltagent/internal": "^1.0.3",
    "@voltagent/supabase": "^2.1.3",
    "ai": "^6.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.2.1",
    "happy-dom": "^15.11.0",
    "typescript": "^5.8.2",
    "vite": "^5.4.10",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "agent",
    "ai",
    "voltagent",
    "web-worker",
    "browser",
    "vite",
    "supabase"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/VoltAgent/voltagent.git",
    "directory": "examples/with-web-worker"
  }
}
